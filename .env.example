# Optional bounded interpreter mode.
#
# The deterministic benchmark, the demo, the release gate and all tests run
# with none of these set. They are only needed for `--real-interpreter`, which
# lets the B3 arm consult a live model on ambiguous cases. Even then the
# interpreter is an annotation service: it cannot authorize a payment action,
# change consent, or reach the provider. That boundary is enforced in
# bailiff/guardrails.py, not by the model's cooperation.

# Read by the OpenAI-compatible client. Never commit a real key.
OPENAI_API_KEY=

# Point the OpenAI-compatible client at another provider. Leave unset for
# OpenAI itself. Example (Groq): https://api.groq.com/openai/v1
MANDATEGUARD_INTERPRETER_BASE_URL=

# Model id at whichever endpoint is configured above. Default: gpt-5-mini
MANDATEGUARD_INTERPRETER_MODEL=

# Cost accounting for the interpreter's token usage, in USD per 1M tokens,
# and the INR conversion used when reporting model cost.
MANDATEGUARD_MODEL_INPUT_USD_PER_1M=
MANDATEGUARD_MODEL_OUTPUT_USD_PER_1M=
MANDATEGUARD_USD_TO_INR=

# Force the deterministic offline interpreter stub regardless of the above.
MANDATEGUARD_OFFLINE=1

# Optional RecoveryTruth provider-backed demo.
# TEST MODE ONLY. `RazorpayTestModeClient.from_env()` refuses a key that does
# not begin with `rzp_test_`. Never commit populated values and never put them
# in screenshots, receipts, benchmark outputs or submission archives.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
